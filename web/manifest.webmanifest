{
  "name": "AURA — Phone Customization Studio",
  "short_name": "AURA",
  "description": "Animated wallpapers, floating widgets, depth parallax and micro-effects. Make any phone yours.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "aura-customization-studio",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070c22",
  "theme_color": "#0a0d16",
  "categories": ["personalization", "utilities"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
